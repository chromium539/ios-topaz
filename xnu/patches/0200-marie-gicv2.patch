 #define __ARM_16K_PG__            1
 
-#define HAS_GIC_V3                1
+/*
+ * marie (Huawei P30 Lite, Kirin 710): the GIC is a GIC-400, i.e. GICv2 with
+ * a memory-mapped CPU interface (GICD 0xE82B1000, GICC 0xE82B2000) instead
+ * of GICv3 system registers. Same model as above: Group 0 is TrustZone's,
+ * everything xnu uses is a non-secure Group 1 IRQ (see pe_fiq.c).
+ */
+#define SWEET_GICV2               1
 
 #ifndef ASSEMBLER
 #define PLATFORM_PANIC_LOG_DISABLED
@@ -48,7 +54,12 @@
  * virt, hyp) instead of the usual 13/14/11/10: the virtual timer XNU uses
  * (CNTV) is INTID 16 + 3 = 19.
  */
+#if SWEET_GICV2
+/* Kirin 710 uses the usual numbering: virtual timer PPI 11 = INTID 27 */
+#define SWEET_VTIMER_INTID        27
+#else
 #define SWEET_VTIMER_INTID        19
+#endif
 #define SWEET_IPI_SGI             1       // SGI used for cross-CPU signals
 
 #define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
@@ -81,4 +92,25 @@
 #define ICC_SRE_SRE                             0x1
 /* End of GICv3 register definitions */
 
+/* GICv2 register definitions; see GICv2 spec (Arm IHI 0048B) */
+#define GICD_TYPER                0x004
+#define GICD_ISENABLER0           0x100
+#define GICD_IPRIORITYR0          0x400
+#define GICD_ITARGETSR0           0x800
+#define GICD_SGIR                 0xf00
+#define GICD_SGIR_TARGET_SHIFT    16
+
+#define GICC_CTLR                 0x000
+#define GICC_PMR                  0x004
+#define GICC_BPR                  0x008
+#define GICC_IAR                  0x00c
+#define GICC_EOIR                 0x010
+
+/* Non-secure view of GICC_CTLR */
+#define GICC_CTLR_ENABLEGRP1      0x1
+#define GICC_CTLR_EOIMODENS       0x200
+
+#define GICC_IAR_INTID_MASK       0x3ff   /* bits 12:10 = SGI source CPU */
+/* End of GICv2 register definitions */
+
 #endif /* ! _PEXPERT_ARM64_SWEET_H */
