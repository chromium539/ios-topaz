diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..5e80240 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -11,6 +11,9 @@
 #include <machine/machine_routines.h>
 #include <pexpert/device_tree.h>
 #include <pexpert/arm64/board_config.h>
+#if SWEET_GICV2
+#include <pexpert/arm/protos.h>
+#endif
 
 
 #if HAS_GIC_V3
@@ -222,6 +225,129 @@ pe_init_fiq()
 	__builtin_arm_isb(ISB_SY);
 #endif /* SWEET */
 }
+#elif SWEET_GICV2
+/*
+ * marie: GIC-400 (GICv2). Huawei's firmware hands over with the distributor
+ * and the boot CPU's interface already enabled for Group 1 and PMR 0xF0
+ * (milestone 0); secure firmware keeps GICD_IGROUPRn, which read as zero
+ * from the non-secure side. The ADT reg is <GICD base, size, GICC base,
+ * size>, relative to the SoC base like the GICv3 node.
+ */
+SECURITY_READ_ONLY_LATE(uint32_t) sweet_vtimer_intid = SWEET_VTIMER_INTID;
+
+static vm_offset_t gicd_base;
+static vm_offset_t gicc_base;
+/* Each logical CPU's GICD_ITARGETSR0 byte: its CPU interface bit (banked) */
+static volatile uint8_t gic_cpu_target[MAX_CPUS];
+
+#define gicd_read32(offset) (*(volatile uint32_t *)(gicd_base + (offset)))
+#define gicd_write32(offset, data) (*(volatile uint32_t *)(gicd_base + (offset)) = (data))
+#define gicc_read32(offset) (*(volatile uint32_t *)(gicc_base + (offset)))
+#define gicc_write32(offset, data) (*(volatile uint32_t *)(gicc_base + (offset)) = (data))
+
+uint32_t
+sweet_gic_ack(void)
+{
+	return gicc_read32(GICC_IAR);
+}
+
+void
+sweet_gic_eoi(uint32_t iar)
+{
+	gicc_write32(GICC_EOIR, iar);
+}
+
+void
+sweet_gic_send_sgi(unsigned int cpu, uint64_t mpidr, unsigned int sgi)
+{
+	uint8_t target = cpu < MAX_CPUS ? gic_cpu_target[cpu] : 0;
+
+	if (target == 0) {
+		/* Not through pe_init_fiq yet: Kirin numbers interfaces cluster * 4 + core */
+		target = (uint8_t)(1U << ((((mpidr >> 8) & 0xff) * 4 + (mpidr & 0xff)) & 7));
+	}
+	__builtin_arm_dsb(DSB_ISHST);
+	gicd_write32(GICD_SGIR, ((uint32_t)target << GICD_SGIR_TARGET_SHIFT) | sgi);
+}
+
+void
+pe_init_fiq()
+{
+	int error;
+	DTEntry entry;
+
+	// Boot CPU only: SecureDT* routines are not thread-safe (see GICv3 path).
+	if (!gicd_base) {
+		error = SecureDTLookupEntry(NULL, "/arm-io/gic", &entry);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC node in DT", __func__);
+		}
+
+		void const *prop;
+		unsigned int prop_size;
+		error = SecureDTGetProperty(entry, "reg", &prop, &prop_size);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC MMIO regions in DT", __func__);
+		}
+
+		// GICD base, GICD size, GICC base, GICC size
+		if (prop_size < 4 * sizeof(uint64_t)) {
+			panic("%s: incorrect reg property size in GIC DT node; expecting 32 bytes but got %u bytes", __func__, prop_size);
+		}
+
+		void const *timer_prop;
+		unsigned int timer_size;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &timer_size) == kSuccess) {
+			if (timer_size != sizeof(uint32_t)) {
+				panic("%s: invalid virtual-timer-intid size %u", __func__, timer_size);
+			}
+			uint32_t intid = *(const uint32_t *)timer_prop;
+			if (intid < 16 || intid >= 32) {
+				panic("%s: virtual timer INTID %u is not a PPI", __func__, intid);
+			}
+			sweet_vtimer_intid = intid;
+		}
+
+		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+		uint64_t const *reg = (uint64_t const *) prop;
+
+		gicd_base = ml_io_map(soc_base_phys + reg[0], reg[1]);
+		if (!gicd_base) {
+			panic("%s: cannot map GICD region", __func__);
+		}
+		gicc_base = ml_io_map(soc_base_phys + reg[2], reg[3]);
+		if (!gicc_base) {
+			panic("%s: cannot map GICC region", __func__);
+		}
+		kprintf("SWEET GIC: GICv2 typer 0x%x, virtual timer INTID %u\n",
+		    gicd_read32(GICD_TYPER), sweet_vtimer_intid);
+	}
+
+	// SGIs and PPIs (INTIDs 0-31) are banked per CPU interface
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicd_write32(GICD_IPRIORITYR0 + i, 0xA0A0A0A0);
+	}
+	gicd_write32(GICD_ISENABLER0, (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
+
+	unsigned int cpu = ml_get_cpu_number_local();
+	if (cpu < MAX_CPUS) {
+		gic_cpu_target[cpu] = (uint8_t)(gicd_read32(GICD_ITARGETSR0) & 0xff);
+		__builtin_arm_dmb(DMB_ISH);
+	}
+
+	gicc_write32(GICC_PMR, 0xF0);
+	gicc_write32(GICC_BPR, 0);
+
+	// Non-secure view: bit 0 of GICD_CTLR is EnableGrp1
+	gicd_write32(GICD_CTLR, gicd_read32(GICD_CTLR) | GICD_CTLR_ENABLEGRP1);
+
+	// EOImodeNS 0: a write to GICC_EOIR also deactivates
+	uint32_t gicc_ctlr = gicc_read32(GICC_CTLR);
+	gicc_ctlr &= ~GICC_CTLR_EOIMODENS;
+	gicc_ctlr |= GICC_CTLR_ENABLEGRP1;
+	gicc_write32(GICC_CTLR, gicc_ctlr);
+	__builtin_arm_isb(ISB_SY);
+}
 #else
 void
 pe_init_fiq()
