marie: keep PAN unchanged on exception entry when built without PAN

SPAN is RES1 on the ARMv8.0 A73, so the phone is unaffected. QEMU's
cortex-a76 has PAN: with SPAN=0 every exception set PSTATE.PAN and the
kernel, which never clears it, faulted forever in copyout (16.5M data
aborts at bcopyout in skmem init).

diff --git a/osfmk/arm64/proc_reg.h b/osfmk/arm64/proc_reg.h
index e01c124..b614349 100644
--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -651,11 +651,22 @@
 #define SCTLR_JOP_KEYS_DEFAULT  0
 #endif
 
+/*
+ * SWEET without PAN (topaz/marie: ARMv8.0, where SPAN is RES1): keep PAN
+ * unchanged on exception entry, so an ARMv8.1+ CPU (QEMU's cortex-a76)
+ * does not set PAN behind a kernel that never clears it.
+ */
+#if defined(SWEET) && !__ARM_PAN_AVAILABLE__
+#define SCTLR_SPAN_DEFAULT      SCTLR_PAN_UNCHANGED
+#else
+#define SCTLR_SPAN_DEFAULT      0
+#endif
+
 #define SCTLR_EL1_DEFAULT \
 	(SCTLR_RESERVED | SCTLR_UCI_ENABLED | SCTLR_nTWE_WFE_ENABLED | SCTLR_DZE_ENABLED | \
 	 SCTLR_I_ENABLED | SCTLR_SED_DISABLED | SCTLR_CP15BEN_ENABLED |                    \
 	 SCTLR_SA0_ENABLED | SCTLR_SA_ENABLED | SCTLR_C_ENABLED | SCTLR_M_ENABLED |        \
-	 SCTLR_CSEH_DEFAULT | SCTLR_DSSBS_DEFAULT |                                        \
+	 SCTLR_CSEH_DEFAULT | SCTLR_DSSBS_DEFAULT | SCTLR_SPAN_DEFAULT |                   \
 	 SCTLR_ROP_KEYS_DEFAULT | SCTLR_JOP_KEYS_DEFAULT)
 
 /*
