marie: colour-band markers along the start.s boot path (bring-up)

First 0202 boot: the stage 0 band appeared, the sweet_early stage 1 band
did not. Red = bootstrap page tables built (MMU off), green = MMU and
caches on, yellow = returning to arm_init.

diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index cece8b3..758edde 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -73,6 +73,31 @@
 #endif
 .endmacro
 
+#if defined(SWEET)
+/*
+ * marie bring-up: 64x32 band of colour \col at x = \x on the row above the
+ * sweet_early progress bar, through whatever mapping is live (MMU off: PA;
+ * bootstrap TTBR0: the VA=PA framebuffer block). Clobbers x9-x14.
+ */
+.macro SWEET_BAND col, x
+	MOV64	x9, (SWEET_EARLY_FB_PA + (SWEET_EARLY_FB_HEIGHT - 96) * SWEET_EARLY_FB_STRIDE + \x * 4)
+	MOV64	x10, \col
+	mov		x11, #32
+	MOV64	x14, SWEET_EARLY_FB_STRIDE
+Lsweet_band_row\@:
+	mov		x12, #64
+	mov		x13, x9
+Lsweet_band_px\@:
+	str		w10, [x13], #4
+	subs	x12, x12, #1
+	b.ne	Lsweet_band_px\@
+	add		x9, x9, x14
+	subs	x11, x11, #1
+	b.ne	Lsweet_band_row\@
+	dsb		sy
+.endm
+#endif
+
 .macro MSR_SCTLR_EL1_X0
 #if defined(KERNEL_INTEGRITY_KTRR)
 	mov		x1, lr
@@ -698,6 +723,9 @@ Lkernelcache_base_found:
 	/* Ensure TTEs are visible */
 	dsb		ish
 
+#if defined(SWEET)
+	SWEET_BAND 0xffff0000, 0	/* red: bootstrap page tables built, MMU off */
+#endif
 
 	b		common_start
 
@@ -837,6 +865,10 @@ common_start:
 	MSR_SCTLR_EL1_X0
 	isb		sy
 
+#if defined(SWEET)
+	SWEET_BAND 0xff00ff00, 80	/* green: MMU and caches on (bootstrap TTBR0) */
+#endif
+
 #if !VMAPPLE && !defined(SWEET)
 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
@@ -899,6 +931,12 @@ common_start:
 	mov	lr, x21
 #endif
 
+#if defined(SWEET)
+	mov		x15, x0
+	SWEET_BAND 0xffffff00, 160	/* yellow: returning to arm_init (KVA) */
+	mov		x0, x15
+#endif
+
 	// Return to arm_init()
 	ret
 
