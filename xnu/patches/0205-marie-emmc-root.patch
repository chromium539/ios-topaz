+#else /* SWEET_MARIE */
+/*
+ * marie: the eMMC behind sdhci@FF3E1000 (reg[0] 0xFF3E6000: SDHCI 4.10, the
+ * Kirin "mshc" host). Huawei fastboot hands over with the card selected (RCA
+ * 1) in transfer state, HS400 on 8 bits, command queueing off and the user
+ * area selected (milestone 2 probe, PLAN.md). This reuses that state: polled
+ * PIO through the SDHCI buffer port, one command at a time, no interrupt
+ * signals, no DMA. Data moves through the bounce buffer like the UFS path.
+ */
+#define SD_BLKSIZE      0x04            /* 16-bit block size + 16-bit count at 0x06 */
+#define SD_ARG          0x08
+#define SD_XFER         0x0c            /* 16-bit transfer mode + 16-bit command at 0x0e */
+#define SD_RESP0        0x10
+#define SD_BUFFER       0x20
+#define SD_PSTATE       0x24
+#define SD_SWRESET      0x2f            /* byte */
+#define SD_INTSTS       0x30            /* normal 16 + error 16 */
+#define SD_INTEN        0x34
+#define SD_SIGEN        0x38
+#define SD_ACMDERR      0x3c
+
+#define INT_CMD_DONE    (1u << 0)
+#define INT_XFER_DONE   (1u << 1)
+#define INT_ERROR       (1u << 15)
+#define PSTATE_CMD_INH  (1u << 0)
+#define PSTATE_DAT_INH  (1u << 1)
+#define PSTATE_BUF_WR   (1u << 10)
+#define PSTATE_BUF_RD   (1u << 11)
+#define SWRESET_CMD_DAT 0x06
+
+#define CMD_RESP48      0x02
+#define CMD_RESP48B     0x03
+#define CMD_CRC         0x08
+#define CMD_INDEX       0x10
+#define CMD_DATA        0x20
+#define CMD_R1          (CMD_RESP48 | CMD_CRC | CMD_INDEX)
+#define CMD_R1B         (CMD_RESP48B | CMD_CRC | CMD_INDEX)
+#define XFER_BLKCNT     0x02
+#define XFER_ACMD12     0x04
+#define XFER_READ       0x10
+#define XFER_MULTI      0x20
+
+#define EMMC_RCA        1               /* Linux: mmc0:0001 */
+/* Card status errors (JESD84: out of range, address, block length, WP, ECC, CC, error, illegal, switch) */
+#define R1_ERRORS       0xe4780080u
+#define EMMC_STATE(r1)  (((r1) >> 9) & 0xf)
+#define EMMC_TRAN       4
+
+static uint64_t
+emmc_deadline(uint64_t ns)
+{
+	uint64_t abs;
+	nanoseconds_to_absolutetime(ns, &abs);
+	return mach_absolute_time() + abs;
+}
+
+static void
+emmc_reset_lines(void)
+{
+	*(volatile uint8_t *)(su.regs + SD_SWRESET) = SWRESET_CMD_DAT;
+	uint64_t deadline = emmc_deadline(100 * NSEC_PER_MSEC);
+	while ((*(volatile uint8_t *)(su.regs + SD_SWRESET) & SWRESET_CMD_DAT) &&
+	    mach_absolute_time() < deadline) {
+	}
+	ufs_wr(SD_INTSTS, 0xffffffff);
+}
+
+/* Wait for any of `bits` (or an error) in INT_STATUS; 0 on timeout. */
+static uint32_t
+emmc_wait_int(uint32_t bits, uint64_t deadline)
+{
+	for (;;) {
+		uint32_t st = ufs_rd(SD_INTSTS);
+		if (st & (bits | INT_ERROR)) {
+			return st;
+		}
+		if (mach_absolute_time() > deadline) {
+			return 0;
+		}
+	}
+}
+
+/* Issue one command; data phase (if any) is left to the caller. */
+static int
+emmc_cmd(uint32_t idx, uint32_t arg, uint32_t flags, uint32_t mode, uint32_t *r1)
+{
+	uint32_t inhibit = PSTATE_CMD_INH;
+	if ((flags & CMD_DATA) || (flags & 3) == CMD_RESP48B) {
+		inhibit |= PSTATE_DAT_INH;
+	}
+	uint64_t deadline = emmc_deadline(CMD_TIMEOUT_NS);
+	while (ufs_rd(SD_PSTATE) & inhibit) {
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET EMMC: CMD%u: lines busy (pstate 0x%x)\n", idx, ufs_rd(SD_PSTATE));
+			emmc_reset_lines();
+			return ETIMEDOUT;
+		}
+	}
+	ufs_wr(SD_INTSTS, 0xffffffff);
+	ufs_wr(SD_ARG, arg);
+	ufs_wr(SD_XFER, (idx << 24) | (flags << 16) | mode);
+	uint32_t st = emmc_wait_int(INT_CMD_DONE, deadline);
+	if (st == 0 || (st & INT_ERROR)) {
+		printf("SWEET EMMC: CMD%u arg 0x%x failed: int 0x%x\n", idx, arg, st);
+		emmc_reset_lines();
+		return st ? EIO : ETIMEDOUT;
+	}
+	*r1 = ufs_rd(SD_RESP0);
+	ufs_wr(SD_INTSTS, INT_CMD_DONE);
+	if (*r1 & R1_ERRORS) {
+		printf("SWEET EMMC: CMD%u arg 0x%x: card status 0x%x\n", idx, arg, *r1);
+		emmc_reset_lines();
+		return EIO;
+	}
+	return 0;
+}
+
+/*
+ * One data command (CMD8/17/18/24/25) of count 512-byte blocks to/from the
+ * bounce buffer. Multi-block transfers stop with auto CMD12.
+ */
+static int
+emmc_data(uint32_t idx, uint32_t arg, uint32_t count, bool write)
+{
+	uint32_t *buf = (uint32_t *)(su.dma + DMA_BOUNCE);
+	uint32_t mode = XFER_BLKCNT | (write ? 0 : XFER_READ) | (count > 1 ? XFER_MULTI | XFER_ACMD12 : 0);
+	uint32_t r1, st = 0;
+
+	if (count == 0 || count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	ufs_wr(SD_BLKSIZE, (count << 16) | (7u << 12) | UFS_BLOCK);
+	int error = emmc_cmd(idx, arg, CMD_R1 | CMD_DATA, mode, &r1);
+	if (error) {
+		return error;
+	}
+	uint64_t deadline = emmc_deadline(CMD_TIMEOUT_NS);
+	uint32_t ready = write ? PSTATE_BUF_WR : PSTATE_BUF_RD;
+	for (uint32_t b = 0; b < count; b++) {
+		while (!(ufs_rd(SD_PSTATE) & ready)) {
+			st = ufs_rd(SD_INTSTS);
+			if ((st & INT_ERROR) || mach_absolute_time() > deadline) {
+				goto fail;
+			}
+		}
+		uint32_t *p = buf + b * (UFS_BLOCK / 4);
+		if (write) {
+			for (uint32_t i = 0; i < UFS_BLOCK / 4; i++) {
+				ufs_wr(SD_BUFFER, p[i]);
+			}
+		} else {
+			for (uint32_t i = 0; i < UFS_BLOCK / 4; i++) {
+				p[i] = ufs_rd(SD_BUFFER);
+			}
+		}
+	}
+	/* For writes this includes the card's busy (programming) phase. */
+	st = emmc_wait_int(INT_XFER_DONE, deadline);
+	if (st == 0 || (st & INT_ERROR)) {
+		goto fail;
+	}
+	ufs_wr(SD_INTSTS, 0xffffffff);
+	return 0;
+fail:
+	printf("SWEET EMMC: CMD%u arg 0x%x count %u failed: int 0x%x acmd 0x%x pstate 0x%x\n",
+	    idx, arg, count, st, ufs_rd(SD_ACMDERR) & 0xffff, ufs_rd(SD_PSTATE));
+	emmc_reset_lines();
+	return (st & INT_ERROR) ? EIO : ETIMEDOUT;
+}
+
+static int
+ufs_read_blocks(uint64_t lba, uint32_t count)
+{
+	if (lba > UINT32_MAX) {
+		return EINVAL;
+	}
+	return emmc_data(count > 1 ? 18 : 17, (uint32_t)lba, count, false);
+}
+#endif /* SWEET_MARIE */
+
