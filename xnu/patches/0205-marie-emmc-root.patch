+#if SWEET_MARIE
+static int
+ufs_take_over_host(void)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	uint32_t r1;
+
+	/* Polled: latch every status bit, signal none. */
+	ufs_wr(SD_SIGEN, 0);
+	ufs_wr(SD_INTEN, 0xffff7fffu);
+	ufs_wr(SD_INTSTS, 0xffffffff);
+	int error = emmc_cmd(13, EMMC_RCA << 16, CMD_R1, 0, &r1);
+	if (error || EMMC_STATE(r1) != EMMC_TRAN) {
+		printf("SWEET EMMC: card not in transfer state (error %d, status 0x%x)\n", error, r1);
+		return error ? error : ENXIO;
+	}
+	error = emmc_data(8, 0, 1, false);              /* SEND_EXT_CSD */
+	if (error) {
+		return error;
+	}
+	/* Only the plain user area without command queueing is supported here. */
+	if (b[15] || (b[179] & 7)) {
+		printf("SWEET EMMC: unsupported card setup: CMDQ_MODE_EN %u PARTITION_CONFIG 0x%x\n",
+		    b[15], b[179]);
+		return ENXIO;
+	}
+	su.emmc_cache = (b[33] & 1) != 0;
+	uint32_t sectors;
+	memcpy(&sectors, b + 212, 4);
+	printf("SWEET EMMC: card ready: HS_TIMING %u, %u MiB, cache %s\n",
+	    b[185], sectors >> 11, su.emmc_cache ? "on" : "off");
+	return 0;
+}
+#else
 static int
