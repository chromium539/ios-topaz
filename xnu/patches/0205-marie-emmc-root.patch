 		0, (uint8_t)(count >> 8), (uint8_t)count, 0
 	};
 	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
+#endif
 }
 
 static int
 ufs_sync_cache(void)
 {
+#if SWEET_MARIE
+	/* CMD6 SWITCH: write EXT_CSD FLUSH_CACHE[32] = 1 (R1b: waits for the busy end) */
+	uint32_t r1;
+	if (!su.emmc_cache) {
+		return 0;
+	}
+	int error = emmc_cmd(6, (3u << 24) | (32u << 16) | (1u << 8), CMD_R1B, 0, &r1);
+	if (!error) {
+		uint32_t st = emmc_wait_int(INT_XFER_DONE, emmc_deadline(CMD_TIMEOUT_NS));
+		ufs_wr(SD_INTSTS, 0xffffffff);
+		if (st == 0 || (st & INT_ERROR)) {
+			printf("SWEET EMMC: cache flush busy wait failed: int 0x%x\n", st);
+			emmc_reset_lines();
+			error = EIO;
+		}
+	}
+	if (!error) {
+		error = emmc_cmd(13, EMMC_RCA << 16, CMD_R1, 0, &r1);
+	}
+	return error;
+#else
 	static const uint8_t cdb[10] = { 0x35 };       /* SYNCHRONIZE CACHE(10), whole LUN */
 	return ufs_scsi(cdb, sizeof(cdb), 0, false);
+#endif
 }
 
