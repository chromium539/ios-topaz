marie: framebuffer statistics show the busiest processes

0209 showed all four A73s ~35 % busy on a static home screen and ~80 %
while scrolling at 12 fps. A second statistics line lists the four
processes that used the most CPU in the last second (percent of one
CPU, from fill_taskprocinfo deltas; bsd/dev/sweet_sample.c sweet_top).
CPU busy percentages are clamped (busy and idle ticks are not read
atomically).

diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index b40eccd..b8f3dfd 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -86,3 +86,78 @@ sweet_sample_start(void)
 		thread_deallocate(thread);
 	}
 }
+
+/*
+ * marie: the busiest processes since the previous call, for the framebuffer
+ * statistics line (SweetFramebuffer.cpp, boot-arg sweetfb_stats). Writes
+ * " name pct" for the top four, pct of one CPU over `window` (mach time).
+ * Only the framebuffer's work loop calls it.
+ */
+#include <sys/bsdtask_info.h>
+
+#define SWEET_TOP_MAX   1024
+#define SWEET_TOP_N     4
+struct sweet_top_ent {
+	int      pid;
+	uint64_t t;
+};
+static struct sweet_top_ent sweet_top_tab[2][SWEET_TOP_MAX];
+static int sweet_top_n[2], sweet_top_cur;
+static struct {
+	uint64_t d;
+	char     name[12];
+} sweet_top_best[SWEET_TOP_N];
+
+static int
+sweet_top_proc(proc_t p, __unused void *arg)
+{
+	struct sweet_top_ent *prev = sweet_top_tab[sweet_top_cur ^ 1];
+	struct sweet_top_ent *cur = sweet_top_tab[sweet_top_cur];
+	int nprev = sweet_top_n[sweet_top_cur ^ 1];
+	task_t task = proc_task(p);
+	if (task == TASK_NULL || sweet_top_n[sweet_top_cur] >= SWEET_TOP_MAX) {
+		return PROC_RETURNED;
+	}
+	struct proc_taskinfo_internal ti;
+	bzero(&ti, sizeof(ti));
+	fill_taskprocinfo(task, &ti);
+	uint64_t t = ti.pti_total_user + ti.pti_total_system, d = nprev ? t : 0;
+	int pid = proc_pid(p);
+	for (int i = 0; i < nprev; i++) {
+		if (prev[i].pid == pid) {
+			d = t >= prev[i].t ? t - prev[i].t : 0;
+			break;
+		}
+	}
+	cur[sweet_top_n[sweet_top_cur]++] = (struct sweet_top_ent){ pid, t };
+	for (int i = 0; i < SWEET_TOP_N; i++) {
+		if (d > sweet_top_best[i].d) {
+			memmove(&sweet_top_best[i + 1], &sweet_top_best[i], (SWEET_TOP_N - 1 - i) * sizeof(sweet_top_best[0]));
+			sweet_top_best[i].d = d;
+			strlcpy(sweet_top_best[i].name, proc_best_name(p), sizeof(sweet_top_best[i].name));
+			break;
+		}
+	}
+	return PROC_RETURNED;
+}
+
+void sweet_top(char *buf, size_t len, uint64_t window);
+
+void
+sweet_top(char *buf, size_t len, uint64_t window)
+{
+	sweet_top_n[sweet_top_cur] = 0;
+	bzero(sweet_top_best, sizeof(sweet_top_best));
+	proc_iterate(PROC_ALLPROCLIST, sweet_top_proc, NULL, NULL, NULL);
+	sweet_top_cur ^= 1;
+	size_t n = 0;
+	buf[0] = '\0';
+	for (int i = 0; i < SWEET_TOP_N && sweet_top_best[i].d != 0 && n < len; i++) {
+		int r = snprintf(buf + n, len - n, " %s %llu", sweet_top_best[i].name,
+		    window ? sweet_top_best[i].d * 100 / window : 0);
+		if (r < 0) {
+			break;
+		}
+		n += (size_t)r;
+	}
+}
