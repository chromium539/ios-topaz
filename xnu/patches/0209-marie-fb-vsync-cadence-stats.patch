+void
+AppleCLCD::rearm(IOTimerEventSource *t)
+{
+	uint64_t period, now = mach_absolute_time();
+	nanoseconds_to_absolutetime((uint64_t)SWEET_FB_VSYNC_US * 1000, &period);
+	fNextVsync += period;
+	if (fNextVsync <= now) {
+		/* late (present took longer than a period): skip the missed vsyncs */
+		fNextVsync += ((now - fNextVsync) / period + 1) * period;
+	}
+	t->wakeAtTime((AbsoluteTime)fNextVsync);
+}
