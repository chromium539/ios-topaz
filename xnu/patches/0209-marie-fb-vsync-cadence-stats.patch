+extern "C" processor_t processor_array[];
+extern "C" kern_return_t processor_info(processor_t processor, processor_flavor_t flavor,
+    host_t *host, processor_info_t info, mach_msg_type_number_t *count);
+extern "C" unsigned char iso_font[256 * 16];
+
+/*
+ * Once a second: vsyncs, frames shown (presents), swaps from backboardd,
+ * average / longest present() and the load of each CPU. Always logged;
+ * drawn on the panel with sweetfb_stats=1.
+ */
+void
+AppleCLCD::statsTick(uint64_t now)
+{
+	uint64_t sec;
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &sec);
+	if (now - fStatT0 < sec) {
+		return;
+	}
+	uint64_t swaps = sweet_fb_swap_total();
+	uint64_t avg_us = 0, max_us = 0;
+	if (fStatPresents != 0) {
+		absolutetime_to_nanoseconds(fStatPresAbs / fStatPresents, &avg_us);
+		avg_us /= 1000;
+	}
+	absolutetime_to_nanoseconds(fStatPresMax, &max_us);
+	max_us /= 1000;
+	int n = snprintf(fStatText, sizeof(fStatText), "v%u f%u s%llu p%llu/%llums c",
+	    fStatVsyncs, fStatPresents, swaps - fStatSwaps0, avg_us / 1000, max_us / 1000);
+	for (int i = 0; i < 8 && n > 0 && n < (int)sizeof(fStatText) - 4; i++) {
+		processor_t pr = processor_array[i];
+		if (pr == NULL) {
+			continue;
+		}
+		processor_cpu_load_info_data_t li;
+		mach_msg_type_number_t cnt = PROCESSOR_CPU_LOAD_INFO_COUNT;
+		host_t host;
+		if (processor_info(pr, PROCESSOR_CPU_LOAD_INFO, &host, (processor_info_t)&li, &cnt) != KERN_SUCCESS) {
+			continue;
+		}
+		uint32_t busy = li.cpu_ticks[CPU_STATE_USER] + li.cpu_ticks[CPU_STATE_SYSTEM];
+		uint32_t total = busy + li.cpu_ticks[CPU_STATE_IDLE];
+		uint32_t db = busy - fStatTicks[i][0], dt = total - fStatTicks[i][1];
+		fStatTicks[i][0] = busy;
+		fStatTicks[i][1] = total;
+		uint32_t pct = dt ? (db * 99 + dt / 2) / dt : 0;
+		n += snprintf(fStatText + n, sizeof(fStatText) - n, " %02u", pct);
+	}
+	static uint32_t logged;
+	if (logged < 600 && (logged++ % 10) == 0) {
+		IOLog("SWEET FB stats: %s\n", fStatText);
+	}
+	fStatT0 = now;
+	fStatSwaps0 = swaps;
+	fStatVsyncs = fStatPresents = 0;
+	fStatPresAbs = fStatPresMax = 0;
+	if (fStats) {
+		statsDraw();
+	}
+}
