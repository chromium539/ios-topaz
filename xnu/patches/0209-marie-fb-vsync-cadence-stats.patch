+/* fStatText in iso_font at 2x, white on black, below the status bar. */
+void
+AppleCLCD::statsDraw(void)
+{
+	const uint32_t sc = 2, x0 = 24, y0 = 150;
+	uint8_t *dst = fFlip[0] != NULL ? (uint8_t *)fFlip[fFlipIdx]->getBytesNoCopy() : (uint8_t *)fPixels;
+	size_t len = strnlen(fStatText, sizeof(fStatText));
+	if (x0 + (len + 1) * 8 * sc > fWidth) {
+		len = fWidth / (8 * sc) - 1 - x0 / (8 * sc);
+	}
+	for (uint32_t y = 0; y < 16 * sc; y++) {
+		uint32_t *row = (uint32_t *)(dst + (uint64_t)(y0 + y) * fRowBytes) + x0;
+		const unsigned char *glyphs = iso_font + (y / sc);
+		for (size_t c = 0; c < len; c++) {
+			unsigned char bits = glyphs[(unsigned char)fStatText[c] * 16];
+			for (uint32_t x = 0; x < 8 * sc; x++) {
+				*row++ = (bits & (1u << (x / sc))) ? 0xffffffff : 0xff000000;
+			}
+		}
+	}
 }
 
